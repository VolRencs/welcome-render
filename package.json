{
  "name": "welcome-render",
  "version": "0.1.0",
  "description": "Native scene compositor for GOPlay welcome images",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "native.js",
    "native.d.ts",
    "*.node",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "libc": [
    "glibc"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.18.0",
      "onFail": "error"
    }
  },
  "napi": {
    "binaryName": "welcome-render",
    "targets": [
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --esm --strip --js native.js --dts native.d.ts",
    "build:debug": "napi build --platform --esm --js native.js --dts native.d.ts",
    "test": "node --test test/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "fmt": "cargo fmt",
    "check": "cargo fmt --check && cargo clippy --all-targets -- -D warnings && pnpm typecheck",
    "bench": "node bench/compare.ts",
    "prepack": "pnpm build && pnpm test && pnpm typecheck"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
